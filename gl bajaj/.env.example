# KaamNearby Configuration Example
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_ENV=development
DATABASE_PATH=instance/kaamnearby.db
UPLOAD_FOLDER=uploads/verifications
MAX_CONTENT_LENGTH=5242880 # 5 MB


# Google Gemini (help assistant). Get a key from Google AI Studio. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: change if Google retires this model name
GEMINI_MODEL=gemini-2.5-flash
